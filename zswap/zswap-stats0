#!/bin/bash
Z=/sys/kernel/debug/zswap
stored=$(cat $Z/stored_pages)
pool=$(cat $Z/pool_total_size)
written=$(cat $Z/written_back_pages)
reject_poor=$(cat $Z/reject_compress_poor)
reject_fail=$(cat $Z/reject_reclaim_fail)
same=$(cat $Z/same_filled_pages)

stored_bytes=$((stored * 4096))
ratio=$(echo "scale=2; $stored_bytes / $pool" | bc 2>/dev/null || echo "N/A")

printf "%-24s %12s\n" "Pool RAM footprint:" "$(numfmt --to=iec-i $pool)B"
printf "%-24s %12s\n" "Stored (uncompressed):" "$(numfmt --to=iec-i $stored_bytes)B"
printf "%-24s %12s\n" "Compression ratio:" "${ratio}x"
printf "%-24s %12s\n" "Written to disk:" "$written pages"
printf "%-24s %12s\n" "Same-filled pages:" "$same"
printf "%-24s %12s\n" "Reject (poor compress):" "$reject_poor"
printf "%-24s %12s\n" "Reject (reclaim fail):" "$reject_fail"
